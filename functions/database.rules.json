{
  "rules": {
    "chats": {
      "$chatId": {
        "meta": {
          ".read": "auth != null && data.child('members').child(auth.uid).exists()",
          ".write": "auth != null && ((!data.exists() && newData.child('members').child(auth.uid).val() == true && newData.child('createdBy').val() == auth.uid && (newData.child('type').val() == 'group' || ($chatId.beginsWith('d_') && $chatId.contains(auth.uid)))) || (data.exists() && data.child('createdBy').val() == auth.uid && newData.child('createdBy').val() == auth.uid))",
          ".validate": "newData.hasChildren(['type', 'members', 'createdBy', 'createdAt'])",
          "type":    { ".validate": "newData.val() == 'direct' || newData.val() == 'group'" },
          "name":    { ".validate": "newData.isString() && newData.val().length <= 80" },
          "members": {
            "$uid": { ".validate": "newData.val() == true" }
          },
          "names": {
            "$uid": { ".validate": "newData.isString() && newData.val().length <= 80" }
          },
          "createdBy": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other":    { ".validate": false }
        },
        "messages": {
          ".read": "auth != null && root.child('chats').child($chatId).child('meta').child('members').child(auth.uid).exists()",
          "$msgId": {
            ".write": "auth != null && !data.exists() && root.child('chats').child($chatId).child('meta').child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['senderId', 'type', 'ts']) && newData.child('senderId').val() == auth.uid && newData.child('ts').val() == now && ((newData.child('type').val() == 'text' && newData.child('text').isString()) || ((newData.child('type').val() == 'image' || newData.child('type').val() == 'file') && newData.child('fileUrl').isString()))",
            "senderId": { ".validate": "newData.isString()" },
            "type":     { ".validate": "newData.val() == 'text' || newData.val() == 'image' || newData.val() == 'file'" },
            "text":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
            "fileUrl":  { ".validate": "newData.isString() && newData.val().length <= 600" },
            "fileName": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "ts":       { ".validate": "newData.isNumber()" },
            "$other":   { ".validate": false }
          }
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid == $uid || (root.child('chats').child($chatId).child('meta').child('members').child(auth.uid).exists() && root.child('chats').child($chatId).child('meta').child('members').child($uid).exists()))",
          ".validate": "newData.hasChildren(['type', 'lastTs'])",
          "type":       { ".validate": "newData.val() == 'direct' || newData.val() == 'group'" },
          "name":       { ".validate": "newData.isString() && newData.val().length <= 80" },
          "peerUid":    { ".validate": "newData.isString()" },
          "lastText":   { ".validate": "newData.isString() && newData.val().length <= 200" },
          "lastTs":     { ".validate": "newData.isNumber()" },
          "lastSender": { ".validate": "newData.isString()" },
          "unread":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other":     { ".validate": false }
        }
      }
    },
    "reads": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('meta').child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])",
        "online":   { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other":   { ".validate": false }
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "$token": { ".validate": "newData.isNumber()" }
      }
    },
    "$other": { ".read": false, ".write": false }
  }
}