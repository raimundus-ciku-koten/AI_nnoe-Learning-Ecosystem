{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Store Production DB URI securely",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts\\storeProductionDatabaseCredential.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Replace Production DB URI securely",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts\\storeProductionDatabaseCredential.ps1",
				"-ReplaceExisting"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify encrypted Production backup restore",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts\\verifyProductionBackupRestore.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}