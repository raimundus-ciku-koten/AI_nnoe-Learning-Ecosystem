# Template environment. Salin ke web/.env.local untuk development.
# Supabase anon/publishable key adalah kunci publik; jangan pernah gunakan
# service_role key pada frontend. Firebase tetap dipakai oleh fitur lama
# sampai tahap migrasi fitur dan data berikutnya selesai.
VITE_SUPABASE_URL=https://jvcrmzmuxgyuetkjqady.supabase.co
VITE_SUPABASE_ANON_KEY=

# Transisi: konfigurasi ini masih diperlukan oleh modul Firebase yang belum
# dimigrasikan. Hapus setelah seluruh fitur memakai Supabase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Kunci publik Web Push (Firebase Console → Project settings → Cloud Messaging).
VITE_FIREBASE_VAPID_KEY=

# Site key publik reCAPTCHA Enterprise untuk Firebase App Check.
VITE_RECAPTCHA_SITE_KEY=
# Token debug lokal saja; jangan gunakan atau commit di produksi.
VITE_APPCHECK_DEBUG_TOKEN=

VITE_AI_ENABLED=false
VITE_FUNCTIONS_REGION=asia-southeast2
VITE_USE_EMULATORS=false
