# Template environment. Salin ke web/.env.local untuk development.
# Supabase anon/publishable key adalah kunci publik; jangan pernah gunakan
# service_role key pada frontend.
VITE_SUPABASE_URL=https://jvcrmzmuxgyuetkjqady.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opsional: endpoint Google Apps Script untuk integrasi Workspace lama.
VITE_GAS_URL=

# Server-only Vercel environment variables (never add VITE_ prefix).
# Configure these in Vercel Project Settings > Environment Variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=https://your-app.example
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_TOKEN_ENCRYPTION_KEY_VERSION=1
# During rotation, retain prior version keys as INTEGRATION_TOKEN_ENCRYPTION_KEY_V1, etc.

# Optional OpenAI-compatible provider. Leave unset to keep cloud AI unavailable.
CLOUD_AI_API_URL=
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=

# Optional local Ollama settings. The endpoint must remain localhost.
VITE_LOCAL_AI_ENDPOINT=http://127.0.0.1:11434
VITE_LOCAL_AI_MODEL=llama3.2
