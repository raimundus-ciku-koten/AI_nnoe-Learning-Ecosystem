# Salin menjadi web/.env.local (JANGAN di-commit). Nilai ada di Firebase Console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise). Kosongkan untuk menonaktifkan di lingkungan dev.
VITE_APPCHECK_SITE_KEY=
# Opsional: token debug tetap agar tidak perlu didaftarkan ulang tiap sesi dev.
VITE_APPCHECK_DEBUG_TOKEN=

# true → app terhubung ke Emulator Suite (hanya berlaku saat `vite dev`).
VITE_USE_EMULATOR=false
