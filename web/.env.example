# =============================================================================
# web/.env.example
#
# Template konfigurasi environment. Cara pakai:
#   1. Dari folder `web`, salin berkas ini menjadi `.env.local`:
#        Copy-Item .env.example .env.local
#   2. Isi VITE_SUPABASE_ANON_KEY dengan anon/publishable key dari Supabase
#      Dashboard → Project Settings → API Keys. Jangan gunakan service_role.
#   3. Isi VITE_WEB_PUSH_PUBLIC_KEY hanya jika backend Web Push sudah tersedia.
#   4. Restart `npm run dev` setelah mengubah berkas ini — Vite hanya
#      membaca `.env.*` saat startup.
#
# Untuk produksi, salin juga menjadi `.env.production` (lihat contoh
# terpisah). JANGAN commit `.env.local` — sudah di-ignore git.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase — fondasi migrasi
# Project ref: jvcrmzmuxgyuetkjqady (region: ap-south-1).
# Gunakan anon/publishable key; JANGAN pernah menaruh service_role key di VITE_*.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://jvcrmzmuxgyuetkjqady.supabase.co
VITE_SUPABASE_ANON_KEY=

# Google OAuth Web Client ID. Register each exact local/production origin in
# Google Cloud Console; this is a public client identifier, not a client secret.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Public Google API key for Google Drive Picker. Restrict it to the deployed
# web origins and the APIs used by this app in Google Cloud Console.
VITE_GOOGLE_API_KEY=

# Cloudflare Turnstile site key for login challenges. Preview must use the
# staging widget's public key. Production may use its exact-host widget key only
# after Supabase Production validates CAPTCHA server-side and the negative tests
# pass.
VITE_TURNSTILE_SITE_KEY=

# Public demo trial is off by default. Only enable it in a validated staging
# environment after server-side CAPTCHA and trial controls have passed testing.
VITE_PUBLIC_DEMO_TRIAL_ENABLED=false

# School self-registration remains off until its schema and server-side
# Turnstile enforcement are verified on Supabase Staging.
VITE_PUBLIC_SCHOOL_SIGNUP_ENABLED=false

# Set this non-public Vercel Preview build variable to true only after the
# Staging schema, Auth CAPTCHA rejection cases, and signup/review workflow pass.
STAGING_PUBLIC_SIGNUP_VERIFIED=false

# These non-public Production build acknowledgments do not enable security.
# Set them only after the corresponding Production server-side configuration,
# migrations, and end-to-end tests have been independently completed.
PRODUCTION_CAPTCHA_VERIFIED=false
PRODUCTION_DEMO_TRIAL_VERIFIED=false
PRODUCTION_SCHOOL_SIGNUP_VERIFIED=false

# Enable lower-bandwidth mode in a release after reviewing free-tier usage.
# Browser devices that request reduced data usage enable it automatically.
VITE_ECONOMY_MODE=false

# Public VAPID key for Web Push; must match the Supabase VAPID_PUBLIC_KEY secret.
VITE_WEB_PUSH_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Integrasi aplikasi lama (Google Apps Script).
# Dipakai tombol "Buka aplikasi Ainnoe (GAS)" pada halaman placeholder.
# Kosongkan bila belum dipakai.
# -----------------------------------------------------------------------------
VITE_GAS_URL=
