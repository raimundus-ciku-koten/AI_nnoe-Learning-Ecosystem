# =============================================================================
# web/.env.example
#
# Template konfigurasi environment. Cara pakai:
#   1. Salin berkas ini menjadi `.env.local` (development):
#        cp .env.example .env.local
#   2. Isi nilainya dari Firebase Console → Project settings → General →
#      Your apps → SDK setup and configuration.
#   3. Restart `npm run dev` setelah mengubah berkas ini — Vite hanya
#      membaca `.env.*` saat startup.
#
# Untuk produksi, salin juga menjadi `.env.production` (lihat contoh
# terpisah). JANGAN commit `.env.local` — sudah di-ignore git.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase — fondasi migrasi
# Project ref: jvcrmzmuxgyuetkjqady (region: ap-south-1).
# Gunakan anon/publishable key; JANGAN pernah menaruh service_role key di VITE_*.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://jvcrmzmuxgyuetkjqady.supabase.co
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Firebase Web SDK Config — sementara diperlukan selama migrasi bertahap
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ainnoe-learning-ecosyste-f7432.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ainnoe-learning-ecosyste-f7432
VITE_FIREBASE_APP_ID=1:403373986709:web:42cd47365a320b49f71c9c
VITE_FIREBASE_MEASUREMENT_ID=G-JC0FGSRYNP
VITE_FIREBASE_MESSAGING_SENDER_ID=403373986709
VITE_FIREBASE_STORAGE_BUCKET=ainnoe-learning-ecosyste-f7432.firebasestorage.app
VITE_FIREBASE_VAPID_KEY=

# -----------------------------------------------------------------------------
# Realtime Database — dipakai untuk chat (Bab 8) & presence.
# Kosongkan bila fitur chat belum dipakai. Aplikasi tetap jalan tanpa RTDB.
# -----------------------------------------------------------------------------
VITE_FIREBASE_DATABASE_URL=https://ainnoe-learning-ecosyste-f7432-default-rtdb.asia-southeast1.firebasedatabase.app/

# -----------------------------------------------------------------------------
# App Check (reCAPTCHA Enterprise).
# Produksi membutuhkan site key yang terdaftar pada aplikasi Firebase.
# -----------------------------------------------------------------------------
VITE_RECAPTCHA_SITE_KEY=6LeTDO4tAAAAAEnBa6poBRjHpjT9sH6mOxqRZndj
# Token debug App Check — hanya untuk localhost.
# Daftarkan di Console → App Check → Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=

# -----------------------------------------------------------------------------
# AI / Cloud Functions — opsional.
# Paket Spark: Cloud Functions tidak bisa di-deploy → biarkan false.
# Ubah ke true HANYA setelah fungsi ter-deploy di paket Blaze.
# -----------------------------------------------------------------------------
VITE_AI_ENABLED=false
VITE_FUNCTIONS_REGION=asia-southeast2
VITE_BILLING_PPN_RATE=0.11

# ---------------------------------------------------------------------------
# Google AdSense web/PWA — optional; only set after site approval and ad setup.
# Publisher IDs and slot IDs are public identifiers, never API credentials.
# ---------------------------------------------------------------------------
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_ID=

# -----------------------------------------------------------------------------
# Integrasi aplikasi lama (Google Apps Script).
# Dipakai tombol "Buka aplikasi Ainnoe (GAS)" pada halaman placeholder.
# Kosongkan bila belum dipakai.
# -----------------------------------------------------------------------------
VITE_GAS_URL=

# -----------------------------------------------------------------------------
# Development
# true  → semua trafik ke Emulator Suite lokal (Auth 9099, Firestore 8080,
#         RTDB 9001, Functions 5001, Storage 9199). Gunakan `firebase emulators:start`
#         di terminal terpisah.
# false → ke proyek Firebase sungguhan.
# WAJIB false di produksi.
# -----------------------------------------------------------------------------
VITE_USE_EMULATORS=false